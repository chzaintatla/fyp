{
  "manifest_version": 3,
  "name": "Agent X Browser Bridge",
  "version": "1.2.0",
  "description": "Connect Agent X AI to exact browser tabs and YouTube controls (play, pause, seek, speed, volume, next, results, scroll).",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/browser-extension/setup.html*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Agent X: click to reconnect"
  }
}
