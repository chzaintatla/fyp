# AgentDesk AI - example environment configuration.
# Copy to backend/.env and fill in real values. NEVER commit a real API key.
# These are placeholders, not real credentials.
# Enter GROQ_API_KEY only in your local backend/.env, never in this template,
# frontend code, source control, or chat.

# AI provider: "groq" (primary - real LLM with tool calling),
# "openai" (alternative), or "mock" (explicit offline/test mode only).
# Mock is NEVER a silent fallback: a misconfigured provider fails loudly.
AI_PROVIDER=groq

# Groq model with tool-calling support (verified Oct 2026).
# Alternatives: llama-3.1-8b-instant (faster, higher free limits),
# openai/gpt-oss-120b, qwen/qwen3-32b.
# Check https://console.groq.com/docs/models for the current catalogue.
AI_MODEL=openai/gpt-oss-120b

# Required when AI_PROVIDER=groq. Put the key in backend/.env only.
# Create a key at:
# https://console.groq.com/keys
# Keep secret: never frontend, never Git, never share in chat.
GROQ_API_KEY=
# Optional: several keys, comma separated. When one hits its limit the next is used automatically.
GROQ_API_KEYS=
# Optional: use the cloud brain on Render (then the keys live there, not on this PC).
CLOUD_BRAIN_URL=
CLOUD_BRAIN_TOKEN=

# Groq speech models (backend/app/ai/groq_client.py). STT tries the fallback
# when the first model is unavailable or rate-limited.
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_FALLBACK_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn

# Max tool-calling steps per task (cost + runaway protection).
AGENT_MAX_STEPS=10

# Alternative provider (only used when AI_PROVIDER=openai).

# SQLite database location
DATABASE_URL=sqlite:///./agentdesk.db

# Allowed origin for the frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Comma-separated list of directories the assistant may touch.
# Empty = user's home directory + ./agentdesk_test
AGENTDESK_ALLOWED_DIRECTORIES=

# Comma-separated list of application names allowed for low-risk launching
AGENTDESK_APPROVED_APPLICATIONS=chrome,notepad,calc,explorer

# Dedicated directory for development/testing file operations
AGENTDESK_TEST_DIR=./agentdesk_test

# Per-tool execution timeout in seconds
TOOL_TIMEOUT_SECONDS=30

# Optional real backup for Groq 429 responses (default: none).
# Enable one only after configuring its valid key and account billing/quota.
# AI_FALLBACK_PROVIDER=gemini or openai
AI_FALLBACK_PROVIDER=none
# Leave empty to use the provider-specific default below.
AI_FALLBACK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini

# Local PC agent by default. AI:/research/explain requests opt into cloud reasoning.
# Set automatic only to allow arbitrary unmatched commands to use the API.
AI_CLOUD_MODE=explicit

# Data retention. 0 (default) = keep everything. If set to N days, finished tasks older than N days
# lose their stored AI conversation and expired rollback backups are deleted. Task history,
# actions and results are never deleted.
RETENTION_DAYS=0

# Folder for structured JSON logs (default: %LOCALAPPDATA%\AgentDesk\logs\agentdesk.log, rotated 5 MB x 3).
# Logs never contain commands, tool arguments, file contents, prompts or API keys.
# AGENTDESK_LOG_DIR=

# Local usage plan: unlimited (default, no limits), standard, or free. An unknown value stops startup.
# Limits apply only to new tasks per day and cloud-AI calls per day/month; local PC commands,
# approvals, rollback and logging are never limited. This is a local budget guard, not licensing.
AGENTDESK_PLAN=unlimited
